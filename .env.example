NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/cvbuilder?retryWrites=true&w=majority

JWT_SECRET=change-me-to-long-random-string
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx

# Optional: Paystack webhook secret for signature verification
PAYSTACK_WEBHOOK_SECRET=

# Download grace period in days (business rule: 25)
DOWNLOAD_ACCESS_DAYS=25

# One-time CV download unlock price (GHS)
DOWNLOAD_PRICE_GHS=25

# Translation price in smallest currency unit if using pesewas — app uses GHS amount in API (6)
TRANSLATION_PRICE_GHS=6

# Required for paid CV translation (preferred). Never expose this in the client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional DeepL fallback if OPENAI_API_KEY is unset. Use a key ending in :fx for the free endpoint.
DEEPL_API_KEY=
